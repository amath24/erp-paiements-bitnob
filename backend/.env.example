# --- Bitnob (même Client ID en sandbox et prod, seul le Secret change) ---
BITNOB_CLIENT_ID=your_client_id
BITNOB_CLIENT_SECRET=your_sandbox_secret
BITNOB_BASE_URL=https://api.bitnob.com

# URL publique (ngrok) : reçoit les webhooks ET est donnée aux cartes à leur création
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

# Protège TES endpoints (header X-API-Key) – à changer
APP_API_KEY=change-me

# --- Enveloppes budgétaires ---
# customer_id obtenu après un Card KYC approuvé (évite de le renvoyer à chaque création)
DEFAULT_CARD_CUSTOMER_ID=
# Alerte "solde bas" quand il reste moins que ce montant (USD)
ALERT_THRESHOLD_USD=10

# --- MODE SIMULÉ : tout fonctionne sans Bitnob ni identifiants (pour dev / démo hors-ligne) ---
BITNOB_MOCK=false
MOCK_DELAY_SECONDS=2            # délai entre les étapes simulées (webhooks)
MOCK_BALANCE_USD=1000           # solde de départ des wallets simulés
MOCK_INVOICE_PAY_SECONDS=0      # >0 : les factures se paient seules après N secondes
